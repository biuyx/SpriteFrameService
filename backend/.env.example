# SpriteFrameService 环境配置（复制为 .env 后按需修改）
# 复制示例：cp .env.example .env  (Windows: copy .env.example .env)

# 运行时数据目录（sessions 存放于此）。相对路径相对于 <project_root>。
SPRITE_DATA_DIR=data

# 模型根目录（ai抠图模型 .onnx、rtmpose/、realesrgan/ 均在其中）。
# 开发期可指向原项目 models 目录复用，例如：
# SPRITE_MODELS_DIR=E:/Creative/SpriteFrameStudio_ori/models
# 未设置时默认 <project_root>/models

# 外部工具目录（pngquant 位于 <tools>/pngquant/）。未设置默认 <project_root>/tools
# SPRITE_TOOLS_DIR=tools

# 前端 dist 目录（未设置默认 <project_root>/frontend/dist）
# SPRITE_FRONTEND_DIR=frontend/dist

# 服务监听
SPRITE_HOST=127.0.0.1
SPRITE_PORT=8000

# 允许的跨域来源，逗号分隔；"*" 表示不限制（本机自用默认值）。
# 对外暴露时应收敛为具体来源，例如：
# SPRITE_CORS_ORIGINS=https://sprite.example.com
SPRITE_CORS_ORIGINS=*

# 任务失败时是否把完整 traceback 返回给前端（仅调试期开启，会泄露服务端路径）
SPRITE_DEBUG_ERRORS=false

# 处理设置
SPRITE_MAX_WORKERS=2
# 强制 CPU（不尝试 CUDA provider）
SPRITE_FORCE_CPU=false

# 资源上限
# 单个视频上传大小上限（MB）
SPRITE_MAX_UPLOAD_MB=2048
# 单次抽帧的帧数上限（每帧一张 PNG 落盘）
SPRITE_MAX_EXTRACT_FRAMES=2000

# 允许 RTMPose 在本地模型缺失时联网下载权重（默认关闭：离线部署 + 下载不校验哈希）
SPRITE_ALLOW_MODEL_DOWNLOAD=false
